<?xml version="1.0"?>

<sdf version="1.9">

  <model name="mars_pathfinder">

    <!-- Fixed model -->
    <static>true</static>

    <link name="base_link">

      <!-- 3D visual model -->
      <visual name="pathfinder_visual">

        <geometry>
          <mesh>
            <uri>model://mars_pathfinder/meshes/model.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </visual>

      <!-- Simplified collision geometry -->
      <collision name="body_collision">

        <pose>0 0 0.5 0 0 0</pose>

        <geometry>
          <box>
            <size>1.5 1.5 1.0</size>
          </box>
        </geometry>

      </collision>

    </link>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>mars_pathfinder</robot_base_frame>
      <odom_topic>/pathfinder/odometry</odom_topic>
      <odom_publish_frequency>10</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

  </model>

</sdf>